rules_version = '2';

// Shingu Firestore güvenlik kuralları
// Genel ilke: kullanıcı yalnızca kendi verisini görür/değiştirir, admin her şeyi yönetir.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yardımcı fonksiyonlar ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Rol bilgisi users/{uid} belgesindeki "role" alanından okunur
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Giriş yapan kullanıcının hesabı aktif mi? Dondurulmuş/askıdaki/silinmiş hesap sipariş veremez ve yorum
    // yazamaz (uygulama bu hesapların oturumunu zaten kapatır; bu kural doğrudan veritabanı isteklerini de engeller)
    function isActiveUser() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Kullanıcının kendi hesap durumunda yapabileceği değişiklikler (üyeliği geçici pasifleştirme):
    //  - durumu değiştirmeden diğer bilgilerini güncellemek
    //  - aktif hesabını askıya almak (suspendedBy: "user")
    //  - KENDİ askıya aldığı hesabı yeniden etkinleştirmek; admin'in dondurduğu hesabı kendisi açamaz
    function isAllowedOwnStatusChange() {
      let before = resource.data.get('status', 'active');
      let after = request.resource.data.get('status', 'active');
      let byBefore = resource.data.get('suspendedBy', null);
      let byAfter = request.resource.data.get('suspendedBy', null);
      return (after == before && byAfter == byBefore)
        || (before == 'active' && after == 'suspended' && byAfter == 'user')
        || (before == 'suspended' && byBefore == 'user' && after == 'active' && byAfter == null);
    }

    // İptal stok iadesi: ürüne yazılan lastRestockOrderId'deki sipariş
    //  - işlemden önce bu kullanıcıya ait ve "Beklemede" (get), işlemden sonra "İptal edildi" (getAfter) olmalı
    //  - stok tam olarak o siparişteki adet kadar artmalı
    // Sipariş işlemden önce zaten iptal edilmiş olsaydı get() "Beklemede" dönmezdi; aynı iptalle iki kez iade yapılamaz.
    function isRestockByOwnCancellation(productId) {
      let orderPath = /databases/$(database)/documents/orders/$(request.resource.data.lastRestockOrderId);
      let before = get(orderPath).data;
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastRestockOrderId'])
        && before.userId == request.auth.uid
        && before.status == 'pending'
        && getAfter(orderPath).data.status == 'cancelled'
        && request.resource.data.stock == resource.data.stock + before.itemQuantities[productId];
    }

    // Uygulamadaki DeliveryArea.isServed ile aynı kural
    function isInDeliveryArea(address) {
      return address.get('countryCode', null) != null
        ? address.countryCode.lower() == 'tr'
        : (address.latitude >= 35.8 && address.latitude <= 42.2
           && address.longitude >= 25.6 && address.longitude <= 44.9);
    }

    // ---------- Kullanıcılar ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Kayıtta kullanıcı kendine admin rolü veremez ve hesap aktif başlar
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.get('status', 'active') == 'active';
      // Kullanıcı sadece adını, e-postasını ve (yukarıdaki kurallarla) hesap durumunu değiştirebilir; rolünü değiştiremez.
      // E-posta alanı, giriş hesabının doğrulanmış e-postasından farklı bir değere çevrilemez.
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['fullName', 'email', 'status', 'suspendedBy', 'statusUpdatedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
                || request.resource.data.email == request.auth.token.email)
            && isAllowedOwnStatusChange());
      // Admin herkesi silebilir; kullanıcı kendi profilini "Hesabımı Sil" ile silebilir (KVKK / Google Play)
      allow delete: if isAdmin() || isOwner(uid);

      // Sepet, favoriler ve adresler: sahibi yönetir; admin hesap silerken okuyup temizleyebilir
      match /cart/{productId} {
        allow read, write: if isOwner(uid);
        allow read, delete: if isAdmin();
      }
      match /favorites/{productId} {
        allow read, write: if isOwner(uid);
        allow read, delete: if isAdmin();
      }
      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
        allow read, delete: if isAdmin();
      }

      // "Ürün Yorumlarım" için yorum kopyası; admin bir yorumu ya da hesabı silerken kopyayı da siler
      match /reviews/{productId} {
        allow read, write: if isOwner(uid);
        allow read, delete: if isAdmin();
      }
    }

    // ---------- Kampanyalar (ana sayfa slaytı) ----------
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Kategoriler ----------
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Ürünler ----------
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // Admin her alanı günceller. Kullanıcı:
      //  - sipariş verirken stoğu azaltabilir (0'ın altına inemez)
      //  - kendi "Beklemede" siparişini iptal ederken, o siparişteki adet kadar stoğu geri ekleyebilir
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock)
        || isRestockByOwnCancellation(productId);

      // Yorumlar: belge kimliği yazanın uid'i, puan 1-5, yorum en fazla 500 karakter
      match /reviews/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId)
          && isActiveUser()
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ---------- Siparişler ----------
    match /orders/{orderId} {
      // Kullanıcı sadece kendi siparişlerini görür, admin hepsini
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Sipariş kendi adına, "Beklemede" durumunda ve ödemesi alınmış (test) olarak oluşturulabilir.
      // Ödeme alanı sadece özet içerebilir: kart numarasının tamamı veya CVV veritabanına yazılamaz.
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.payment.status == 'paid'
        && request.resource.data.payment.keys().hasOnly(['method', 'cardBrand', 'cardLast4', 'status', 'testMode', 'paidAt'])
        && request.resource.data.payment.cardLast4.size() == 4
        // Kargo alanı: Türkiye. Ülke kodu olan adreste "tr" olmalı; ülke kodu olmayan (eski) adreste
        // koordinatlar Türkiye'nin yaklaşık sınırları içinde olmalı
        && isInDeliveryArea(request.resource.data.address);
      // Durum değişikliği (işleme alındı, kargoda, teslim) ve silme admin.
      // Kullanıcı sadece kendi "Beklemede" siparişini "İptal edildi" yapabilir, başka alana dokunamaz.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'user'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'statusUpdatedAt', 'cancelledBy', 'statusHistory']));
      allow delete: if isAdmin();
    }

    // ---------- Kuponlar ----------
    // Kullanıcılar kupon kodunu doğrulamak ve "Kuponlarım"da listelemek için okuyabilir; sadece admin yönetir
    match /coupons/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Geri bildirimler ----------
    // Kullanıcı kendi adına geri bildirim gönderebilir; okuma, "okundu" işareti ve silme admin'de
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Puan özetleri (collection group) ----------
    // Ana sayfadaki puan ortalamaları tüm "reviews" koleksiyonlarını tek sorguyla okur.
    // users/{uid}/reviews kopyaları da aynı (herkese açık) yorumların kopyası olduğu için okunabilir.
    match /{path=**}/reviews/{reviewId} {
      allow read: if isSignedIn();
    }
  }
}
