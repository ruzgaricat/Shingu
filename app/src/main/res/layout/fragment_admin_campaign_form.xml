<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kw_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="20dp">

        <TextView
            android:id="@+id/tvCampaignFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="20dp"
            android:text="Yönetici: Yeni Kampanya"
            android:textColor="@color/kw_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="20dp"
            android:text="Kampanya adıyla aynı isimde bir kategori otomatik açılır. Ana sayfadaki banner'a dokunan kullanıcı bu kategoriye gider; kampanya silinirse kategori de silinir."
            android:textColor="@color/kw_text_secondary"
            android:textSize="13sp" />

        <!-- Canlı önizleme: banner'ın ana sayfada nasıl görüneceği -->
        <FrameLayout
            android:id="@+id/layoutBannerPreview"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Shingu.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            app:counterEnabled="true"
            app:counterMaxLength="30">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCampaignTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kampanya Adı (Örn: Kış Fırsatları)"
                android:inputType="textCapWords"
                android:maxLength="30" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Shingu.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCampaignImageUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fotoğraf Bağlantısı (URL)"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Telefondan fotoğraf seçip Cloudinary'ye yükler, bağlantıyı yukarıdaki alana yazar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickCampaignImage"
            style="@style/Widget.Shingu.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:text="Galeriden Seç ve Yükle" />

        <Button
            android:id="@+id/btnSaveCampaign"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/kw_primary"
            android:text="Kampanyayı Oluştur"
            android:textSize="16sp" />

        <!-- Sadece düzenleme modunda görünür -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteCampaign"
            style="@style/Widget.Shingu.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:text="Kampanyayı Sil"
            android:textColor="@color/kw_error"
            android:visibility="gone"
            app:strokeColor="@color/kw_error" />

    </LinearLayout>
</ScrollView>
