<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F9F9F9"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Başlık -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Aramıza Katılın"
            android:textColor="#2C3E50"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Shingu hesabınızı hemen oluşturun"
            android:textColor="#7F8C8D"
            android:textSize="16sp" />

        <!-- Ad Soyad Alanı -->
        <EditText
            android:id="@+id/etRegisterName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Ad Soyad"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp" />

        <!-- E-posta Alanı -->
        <EditText
            android:id="@+id/etRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="E-posta Adresi"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp" />

        <!-- Şifre Alanı -->
        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Şifre (En az 6 karakter)"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp" />

        <!-- Kayıt Ol Butonu -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#2C3E50"
            android:text="Kayıt Ol"
            android:textColor="#FFFFFF" />

        <!-- Giriş Ekranına Dönüş -->
        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="Zaten hesabınız var mı? Giriş Yapın"
            android:textColor="#3498DB" />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>