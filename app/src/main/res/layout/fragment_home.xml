<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kw_bg"
    android:orientation="vertical">

    <!-- Hava durumu şeridi (Open-Meteo API): ekranın üstünü boydan boya kaplar -->
    <TextView
        android:id="@+id/tvWeatherStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kw_secondary_soft"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Hava durumu yükleniyor..."
        android:textColor="@color/kw_secondary_text"
        android:textSize="14sp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Ürün arama: ad, açıklama ve kategoride arar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSearch"
                style="@style/Widget.Shingu.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@android:drawable/ic_menu_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ürün, kategori ara..."
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Arama yapılırken gizlenen bölümler: kampanya slaytı ve kategori kısayolları -->
            <LinearLayout
                android:id="@+id/layoutBrowseSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Kampanya slaytı: admin'in oluşturduğu kampanyalar; kampanya yoksa gizlenir -->
                <LinearLayout
                    android:id="@+id/layoutCampaigns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpCampaigns"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="12dp" />

                    <!-- Sayfa göstergesi: aktif sayfa altın sarısı ve daha uzun -->
                    <LinearLayout
                        android:id="@+id/layoutIndicators"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Kategori kısayolları -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:text="✿ Kategoriler"
                    android:textColor="@color/kw_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupHomeCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Ürün listesi başlığı ve sonuç sayısı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProductsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✿ Tüm Ürünler"
                    android:textColor="@color/kw_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/kw_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Sıralama -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Shingu.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp">

                <AutoCompleteTextView
                    android:id="@+id/actvSort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Sırala"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Filtreler -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterInStock"
                        style="@style/Widget.Shingu.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stokta olanlar" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterDiscounted"
                        style="@style/Widget.Shingu.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İndirimli" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterRated"
                        style="@style/Widget.Shingu.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4★ ve üzeri" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Fiyat aralığı -->
            <TextView
                android:id="@+id/tvPriceRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="Fiyat aralığı"
                android:textColor="@color/kw_text_body"
                android:textSize="13sp" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/sliderPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:stepSize="0"
                android:valueFrom="0"
                android:valueTo="1"
                app:haloColor="@color/kw_primary_soft"
                app:thumbColor="@color/kw_primary"
                app:thumbHeight="22dp"
                app:thumbStrokeColor="@color/white"
                app:thumbStrokeWidth="3dp"
                app:thumbTrackGapSize="0dp"
                app:thumbWidth="22dp"
                app:trackColorActive="@color/kw_primary"
                app:trackColorInactive="@color/kw_primary_soft"
                app:trackHeight="6dp"
                app:trackStopIndicatorSize="0dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHomeProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/tvHomeProductsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Ürünler yükleniyor..."
                android:textColor="@color/kw_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
