<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kw_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Başlık: sipariş no, tarih, durum -->
        <TextView
            android:id="@+id/tvDetailOrderNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kw_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailOrderMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/kw_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rounded_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Durum geçmişi (zaman çizelgesi) -->
        <TextView
            style="@style/OrderDetailSection"
            android:text="Durum Geçmişi" />

        <LinearLayout
            android:id="@+id/layoutDetailTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="12dp" />

        <!-- Ürünler -->
        <TextView
            style="@style/OrderDetailSection"
            android:text="Ürünler" />

        <LinearLayout
            android:id="@+id/layoutDetailItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="12dp" />

        <!-- Ödeme özeti -->
        <TextView
            style="@style/OrderDetailSection"
            android:text="Ödeme Özeti" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvDetailSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/kw_text_body"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDetailTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/kw_price"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Teslimat -->
        <TextView
            style="@style/OrderDetailSection"
            android:text="Teslimat Adresi" />

        <TextView
            android:id="@+id/tvDetailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:padding="12dp"
            android:textColor="@color/kw_text_body"
            android:textSize="14sp" />

        <!-- Kullanıcı: "Beklemede" siparişi; admin: teslim edilmemiş siparişi iptal edebilir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailCancel"
            style="@style/Widget.Shingu.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Siparişi İptal Et"
            android:textColor="@color/kw_error"
            android:visibility="gone"
            app:strokeColor="@color/kw_error" />

        <TextView
            android:id="@+id/tvDetailCancelInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/kw_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
