<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kw_bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvCategoryFormTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Yönetici: Yeni Kategori Oluştur"
        android:textColor="@color/kw_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Kategori Adı -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Shingu.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kategori Adı (Örn: Ev &amp; Yaşam)" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Kategori Görsel URL (İsteğe Bağlı) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.Shingu.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewCategoryImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Görsel Bağlantısı URL (isteğe bağlı)"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Telefondan görsel seçip Cloudinary'ye yükler, bağlantıyı yukarıdaki alana yazar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickCategoryImage"
        style="@style/Widget.Shingu.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Galeriden Seç ve Yükle" />

    <ImageView
        android:id="@+id/ivCategoryPreview"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSaveCategory"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/kw_primary"
        android:text="Kategoriyi Kaydet"
        android:textSize="16sp" />

    <!-- Sadece düzenleme modunda görünür -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteCategory"
        style="@style/Widget.Shingu.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:text="Kategoriyi Sil"
        android:textColor="@color/kw_error"
        android:visibility="gone"
        app:strokeColor="@color/kw_error" />

</LinearLayout>
</ScrollView>
