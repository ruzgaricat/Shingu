<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst Başlık -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Favorilerim"
        android:textColor="#222222"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Favori Ürünlerin Listeleneceği Alan (İleride RecyclerView olacak) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFavorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Favori Ürün Yoksa Görünecek Boş Durum (Empty State) -->
    <LinearLayout
        android:id="@+id/layoutEmptyFavorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/baseline_favorite_24"
            android:tint="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Henüz favori ürününüz yok"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            textAlignment="center"
            android:text="Beğendiğiniz ürünleri favorilere ekleyerek burada listeleyebilirsiniz."
            android:textColor="#777777"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>