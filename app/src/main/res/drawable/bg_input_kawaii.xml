<?xml version="1.0" encoding="utf-8"?>
<!-- Giriş/kayıt metin kutusu: hap şeklinde, odaklanınca pembe çerçeve -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/kw_surface" />
            <corners android:radius="27dp" />
            <stroke android:width="2dp" android:color="@color/kw_primary" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/kw_surface" />
            <corners android:radius="27dp" />
            <stroke android:width="1.5dp" android:color="@color/kw_stroke" />
        </shape>
    </item>
</selector>
